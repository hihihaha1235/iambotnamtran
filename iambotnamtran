-- Cache ESP Elements
local ESPCache = {}

local R15_Joints = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"}
}

local R6_Joints = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"}
}

-- Clear ESP Objects
local function RemoveESP(player)
    if ESPCache[player] then
        local data = ESPCache[player]
        if data.Name then data.Name:Remove() end
        if data.Health then data.Health:Remove() end
        if data.Skeleton then
            for _, line in ipairs(data.Skeleton) do
                line:Remove()
            end
        end
        ESPCache[player] = nil
    end
end

-- Create ESP Objects
local function CreateESP(player)
    if player == LocalPlayer or ESPCache[player] then return end

    local data = {
        Name = Drawing.new("Text"),
        Health = Drawing.new("Text"),
        Skeleton = {}
    }

    data.Name.Size = 14
    data.Name.Center = true
    data.Name.Outline = true
    data.Name.Color = Color3.fromRGB(255, 255, 255)
    data.Name.Visible = false

    data.Health.Size = 13
    data.Health.Center = true
    data.Health.Outline = true
    data.Health.Color = Color3.fromRGB(0, 255, 100)
    data.Health.Visible = false

    for i = 1, 10 do
        local line = Drawing.new("Line")
        line.Thickness = 1.5
        line.Color = Color3.fromRGB(255, 255, 255)
        line.Visible = false
        table.insert(data.Skeleton, line)
    end

    ESPCache[player] = data
end

-- Manage Player Cache
for _, plr in ipairs(Players:GetPlayers()) do
    CreateESP(plr)
end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)

-- Hide ESP Helper
local function HideESP(draw)
    draw.Name.Visible = false
    draw.Health.Visible = false
    for _, line in ipairs(draw.Skeleton) do
        line.Visible = false
    end
end

-- Render Loop (ESP & FOV)
RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    FOVCircle.Position = screenCenter
    FOVCircle.Radius = Settings.FOV_Radius
    FOVCircle.Visible = Settings.FOV_Enabled and Settings.FOV_Visible

    for player, draw in pairs(ESPCache) do
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        if Settings.ESP_Enabled and character and humanoid and hrp and humanoid.Health > 0 then
            local hrpPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

            if onScreen then
                if Settings.ESP_Names then
                    draw.Name.Text = player.DisplayName or player.Name
                    draw.Name.Position = Vector2.new(hrpPos.X, hrpPos.Y - 35)
                    draw.Name.Visible = true
                else
                    draw.Name.Visible = false
                end

                if Settings.ESP_Health then
                    draw.Health.Text = string.format("HP: %d/%d", math.floor(humanoid.Health), humanoid.MaxHealth)
                    draw.Health.Position = Vector2.new(hrpPos.X, hrpPos.Y - 20)
                    draw.Health.Visible = true
                else
                    draw.Health.Visible = false
                end

                if Settings.ESP_Skeleton then
                    local isR15 = character:FindFirstChild("UpperTorso") ~= nil
                    local joints = isR15 and R15_Joints or R6_Joints

                    for idx, pair in ipairs(joints) do
                        local line = draw.Skeleton[idx]
                        local partA = character:FindFirstChild(pair[1])
                        local partB = character:FindFirstChild(pair[2])

                        if line and partA and partB then
                            local posA, visA = Camera:WorldToViewportPoint(partA.Position)
                            local posB, visB = Camera:WorldToViewportPoint(partB.Position)

                            if visA and visB then
                                line.From = Vector2.new(posA.X, posA.Y)
                                line.To = Vector2.new(posB.X, posB.Y)
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        elseif line then
                            line.Visible = false
                        end
                    end
                    for i = #joints + 1, #draw.Skeleton do
                        draw.Skeleton[i].Visible = false
                    end
                else
                    for _, line in ipairs(draw.Skeleton) do line.Visible = false end
                end
            else
                HideESP(draw)
            end
        else
            HideESP(draw)
        end
    end
end)

-- Get Target for Aimbot
local function GetClosestPlayerInFOV()
    local closestPart = nil
    local shortestDistance = Settings.FOV_Radius
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local targetPart = char and char:FindFirstChild(Settings.Aimbot_TargetPart)

            if char and hum and hum.Health > 0 and targetPart then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if not Settings.FOV_Enabled or distance <= Settings.FOV_Radius then
                        if distance < shortestDistance then
                            shortestDistance = distance
                            closestPart = targetPart
                        end
                    end
                end
            end
        end
    end
    return closestPart
end

-- Aimbot Loop
RunService.RenderStepped:Connect(function()
    if Settings.Aimbot_Enabled then
        local target = GetClosestPlayerInFOV()
        if target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end
end)

