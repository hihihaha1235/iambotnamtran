-- UI Builders Helper
local function CreateToggle(text, configKey, callback)
    local btn = Instance.new("TextButton", ContentContainer)
    btn.Size = UDim2.new(1, -10, 0, 32)
    btn.BackgroundColor3 = Settings[configKey] and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(35, 35, 45)
    btn.Text = text .. ": " .. (Settings[configKey] and "BẬT" or "TẮT")
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSans
    btn.TextSize = 14
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        Settings[configKey] = not Settings[configKey]
        btn.BackgroundColor3 = Settings[configKey] and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(35, 35, 45)
        btn.Text = text .. ": " .. (Settings[configKey] and "BẬT" or "TẮT")
        if callback then callback(Settings[configKey]) end
    end)
    return btn
end

local function CreateSelector(text, options, configKey)
    local btn = Instance.new("TextButton", ContentContainer)
    btn.Size = UDim2.new(1, -10, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    btn.Text = text .. ": " .. tostring(Settings[configKey])
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSans
    btn.TextSize = 14
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local currentIndex = 1
    btn.MouseButton1Click:Connect(function()
        currentIndex = (currentIndex % #options) + 1
        Settings[configKey] = options[currentIndex]
        btn.Text = text .. ": " .. tostring(Settings[configKey])
    end)
end

